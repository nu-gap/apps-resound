+/*
+ * .gorm files archive the container's collections in their in-memory
+ * order.  topLevelObjects is a set, and a set's enumeration order is
+ * pointer-hash dependent, i.e. it varies with the memory layout of
+ * each run; the writers likewise populate visibleWindows and
+ * deferredWindows from document sets.  Serializing a collection in
+ * that order makes the archive bytes a function of the run rather
+ * than of the model: converting the same source twice produced
+ * different objects.gorm files, so the gorm conversion output was
+ * not reproducible.
+ *
+ * The collections are instead archived in canonical name order: an
+ * object's name-table key is a pure function of the input model, so
+ * the archive no longer depends on the run-time memory layout.  The
+ * name table maps names to objects, while the sort needs the name of
+ * each object, so the encoder builds the reversed mapping (an
+ * object-keyed map table, see gsnibNamesOf) and passes it as the
+ * sort context.  Objects without a name (which shouldn't occur for
+ * top-level objects) sort after the named ones, keeping their input
+ * order among themselves.
+ */
+static NSComparisonResult
+gsnibCompareObjectsByName (id objA, id objB, void *context)
+{
+  NSMapTable	*names = (NSMapTable *)context;
+  NSString	*nameA = [names objectForKey: objA];
+  NSString	*nameB = [names objectForKey: objB];
+
+  if (nameA == nil)
+    {
+      if (nameB == nil)
+	return 0;
+      return NSOrderedDescending;	/* named objects first */
+    }
+  if (nameB == nil)
+    return NSOrderedAscending;
+  return [nameA compare: nameB];
+}
+
+/*
+ * The reversed name table: a mapping from an object to its name, for
+ * use as the context of gsnibCompareObjectsByName.  Returns an
+ * autoreleased map table.
+ */
+static NSMapTable *
+gsnibNamesOf (NSDictionary *nameTable)
+{
+  NSMapTable	*names;
+  NSEnumerator	*ken;
+  id		key;
+
+  names = [NSMapTable mapTableWithKeyOptions: NSMapTableStrongMemory
+		       valueOptions: NSMapTableStrongMemory];
+  ken = [nameTable keyEnumerator];
+  while ((key = [ken nextObject]) != NULL)
+    [names setObject: key forKey: [nameTable objectForKey: key]];
+  return names;
+}
+
+/*
+ * A canonical (name-sorted) copy of a collection, for deterministic
+ * serialization.  Returns an autoreleased mutable array; the encoder
+ * archives it as an array, and -initWithCoder: normalizes the
+ * decoded top-level array back to a set.
+ */
+static NSMutableArray *
+gsnibDeterministicArray (id collection, NSMapTable *names)
+{
+  NSArray	*array;
+
+  /*
+   * NSSet is not an NSArray subclass in GNUstep; go through the
+   * allObjects bridge for sets.
+   */
+  if ([collection isKindOfClass: [NSSet class]])
+    array = [collection allObjects];
+  else
+    array = collection;
+  return [[array sortedArrayUsingFunction: gsnibCompareObjectsByName
+			         context: names] mutableCopy];
+}
+
 /*
